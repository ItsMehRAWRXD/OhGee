<Window x:Class="KimiAppNative.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OhGee - AI Chat Assistant" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="False">
    
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ChatMessageStyle" TargetType="Border">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MaxWidth" Value="600"/>
        </Style>
        
        <Style x:Key="UserMessageStyle" TargetType="Border" BasedOn="{StaticResource ChatMessageStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        
        <Style x:Key="AIMessageStyle" TargetType="Border" BasedOn="{StaticResource ChatMessageStyle}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    
    <Border Background="#F5F5F5" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="10" 
                            Opacity="0.3" BlurRadius="20" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#0078D4" CornerRadius="12,12,0,0" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="💬 OhGee - AI Chat Assistant" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button x:Name="MinimizeButton" Content="─" Width="30" Height="25" 
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                FontSize="12" Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="✕" Width="30" Height="25" 
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                FontSize="12" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Model Selection -->
            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Height="50">
                <StackPanel Orientation="Horizontal" Margin="20,10,20,10" VerticalAlignment="Center">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ModelComboBox" Width="200" Height="30" VerticalAlignment="Center"
                              SelectionChanged="ModelComboBox_SelectionChanged"/>
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" 
                               Margin="20,0,0,0" Foreground="#666" FontStyle="Italic"/>
                </StackPanel>
            </Border>
            
            <!-- Chat Messages Area -->
            <ScrollViewer Grid.Row="2" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled" Background="White">
                <StackPanel x:Name="ChatPanel" Margin="10"/>
            </ScrollViewer>
            
            <!-- Input Area -->
            <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" 
                    CornerRadius="0,0,12,12">
                <Grid Margin="20,15,20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="20" Height="40">
                            <TextBox x:Name="MessageTextBox" 
                                     VerticalContentAlignment="Center" Padding="15,0,15,0"
                                     FontSize="14" Background="Transparent" 
                                     BorderThickness="0"
                                     KeyDown="MessageTextBox_KeyDown"
                                     TextChanged="MessageTextBox_TextChanged"/>
                        </Border>
                        
                        <Button x:Name="SendButton" Grid.Column="1" Content="Send" 
                                Style="{StaticResource ModernButtonStyle}"
                                Height="40" Width="80" Margin="10,0,0,0"
                                Click="SendButton_Click" IsEnabled="False"/>
                    </Grid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="💡 Tip: Press Enter to send, Shift+Enter for new line" 
                                   FontSize="12" Foreground="#666" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
