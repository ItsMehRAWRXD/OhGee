<Window x:Class="KimiAppNative.GuiTemplateCreator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUI Template Creator - RawrZ Native GUI Designer" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="12,12,0,0" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GUI Template Creator" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" - RawrZ Native GUI Designer" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="MinimizeButton" Content="─" Width="35" Height="30" 
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Click="MinimizeButton_Click" Margin="5,0"/>
                    <Button x:Name="CloseButton" Content="✕" Width="35" Height="30" 
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Click="CloseButton_Click" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="0,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Component Library -->
                <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Component Library Header -->
                        <Border Grid.Row="0" Background="#2D2D30" Height="40">
                            <TextBlock Text="🧩 Component Library" Foreground="White" FontWeight="Bold" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                        </Border>

                        <!-- Component List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Basic Controls -->
                                <Expander Header="Basic Controls" Foreground="White" IsExpanded="True">
                                    <StackPanel Margin="10,5">
                                        <Button x:Name="ButtonComponent" Content="Button" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Button" Click="ComponentButton_Click"/>
                                        <Button x:Name="TextBoxComponent" Content="TextBox" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="TextBox" Click="ComponentButton_Click"/>
                                        <Button x:Name="LabelComponent" Content="Label" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Label" Click="ComponentButton_Click"/>
                                        <Button x:Name="CheckBoxComponent" Content="CheckBox" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="CheckBox" Click="ComponentButton_Click"/>
                                        <Button x:Name="RadioButtonComponent" Content="RadioButton" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="RadioButton" Click="ComponentButton_Click"/>
                                        <Button x:Name="ComboBoxComponent" Content="ComboBox" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="ComboBox" Click="ComponentButton_Click"/>
                                        <Button x:Name="ListBoxComponent" Content="ListBox" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="ListBox" Click="ComponentButton_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Layout Controls -->
                                <Expander Header="Layout Controls" Foreground="White" IsExpanded="True">
                                    <StackPanel Margin="10,5">
                                        <Button x:Name="GridComponent" Content="Grid" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Grid" Click="ComponentButton_Click"/>
                                        <Button x:Name="StackPanelComponent" Content="StackPanel" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="StackPanel" Click="ComponentButton_Click"/>
                                        <Button x:Name="DockPanelComponent" Content="DockPanel" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="DockPanel" Click="ComponentButton_Click"/>
                                        <Button x:Name="WrapPanelComponent" Content="WrapPanel" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="WrapPanel" Click="ComponentButton_Click"/>
                                        <Button x:Name="CanvasComponent" Content="Canvas" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Canvas" Click="ComponentButton_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Advanced Controls -->
                                <Expander Header="Advanced Controls" Foreground="White" IsExpanded="True">
                                    <StackPanel Margin="10,5">
                                        <Button x:Name="DataGridComponent" Content="DataGrid" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="DataGrid" Click="ComponentButton_Click"/>
                                        <Button x:Name="TreeViewComponent" Content="TreeView" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="TreeView" Click="ComponentButton_Click"/>
                                        <Button x:Name="TabControlComponent" Content="TabControl" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="TabControl" Click="ComponentButton_Click"/>
                                        <Button x:Name="MenuComponent" Content="Menu" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Menu" Click="ComponentButton_Click"/>
                                        <Button x:Name="ToolBarComponent" Content="ToolBar" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="ToolBar" Click="ComponentButton_Click"/>
                                        <Button x:Name="StatusBarComponent" Content="StatusBar" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="StatusBar" Click="ComponentButton_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Media Controls -->
                                <Expander Header="Media Controls" Foreground="White" IsExpanded="True">
                                    <StackPanel Margin="10,5">
                                        <Button x:Name="ImageComponent" Content="Image" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Image" Click="ComponentButton_Click"/>
                                        <Button x:Name="MediaElementComponent" Content="MediaElement" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="MediaElement" Click="ComponentButton_Click"/>
                                        <Button x:Name="WebViewComponent" Content="WebView2" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="WebView2" Click="ComponentButton_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Custom Templates -->
                                <Expander Header="Custom Templates" Foreground="White" IsExpanded="True">
                                    <StackPanel Margin="10,5">
                                        <Button x:Name="LoginFormTemplate" Content="Login Form" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="LoginForm" Click="TemplateButton_Click"/>
                                        <Button x:Name="DataEntryTemplate" Content="Data Entry Form" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="DataEntry" Click="TemplateButton_Click"/>
                                        <Button x:Name="DashboardTemplate" Content="Dashboard" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Dashboard" Click="TemplateButton_Click"/>
                                        <Button x:Name="SettingsTemplate" Content="Settings Panel" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="Settings" Click="TemplateButton_Click"/>
                                        <Button x:Name="ChatInterfaceTemplate" Content="Chat Interface" Style="{StaticResource ComponentButtonStyle}" 
                                               Tag="ChatInterface" Click="TemplateButton_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Center Panel - Design Canvas -->
                <Border Grid.Column="1" Background="#1E1E1E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="#2D2D30" Height="50">
                            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                <Button x:Name="NewProjectButton" Content="New" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="NewProjectButton_Click" Margin="5,0"/>
                                <Button x:Name="OpenProjectButton" Content="Open" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="OpenProjectButton_Click" Margin="5,0"/>
                                <Button x:Name="SaveProjectButton" Content="Save" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="SaveProjectButton_Click" Margin="5,0"/>
                                <Separator Margin="10,0"/>
                                <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="UndoButton_Click" Margin="5,0"/>
                                <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="RedoButton_Click" Margin="5,0"/>
                                <Separator Margin="10,0"/>
                                <Button x:Name="PreviewButton" Content="Preview" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="PreviewButton_Click" Margin="5,0"/>
                                <Button x:Name="GenerateCodeButton" Content="Generate Code" Style="{StaticResource ToolbarButtonStyle}" 
                                       Click="GenerateCodeButton_Click" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Design Canvas -->
                        <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10">
                            <Canvas x:Name="DesignCanvas" ClipToBounds="True">
                                <!-- Grid overlay for alignment -->
                                <Canvas.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,20,20"/>
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#E0E0E0" Thickness="0.5"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Canvas.Background>
                                
                                <!-- Default welcome message -->
                                <TextBlock Text="Drag components from the left panel to start designing" 
                                          Foreground="#666666" FontSize="16" 
                                          Canvas.Left="50" Canvas.Top="50"
                                          x:Name="WelcomeMessage"/>
                            </Canvas>
                        </Border>

                        <!-- Status Bar -->
                        <Border Grid.Row="2" Background="#2D2D30" Height="30">
                            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="12"/>
                                <TextBlock Text=" | " Foreground="#666666" Margin="10,0"/>
                                <TextBlock x:Name="PositionText" Text="Position: 0, 0" Foreground="#CCCCCC" FontSize="12"/>
                                <TextBlock Text=" | " Foreground="#666666" Margin="10,0"/>
                                <TextBlock x:Name="ComponentCountText" Text="Components: 0" Foreground="#CCCCCC" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Panel - Properties & Code -->
                <Border Grid.Column="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Properties Header -->
                        <Border Grid.Row="0" Background="#2D2D30" Height="40">
                            <TextBlock Text="Properties &amp; Code" Foreground="White" FontWeight="Bold" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                        </Border>

                        <!-- Properties Panel -->
                        <TabControl Grid.Row="1" Background="#252526" Foreground="White">
                            <TabItem Header="Properties">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10" x:Name="PropertiesPanel">
                                        <TextBlock Text="Select a component to edit properties" 
                                                  Foreground="#CCCCCC" FontStyle="Italic" 
                                                  HorizontalAlignment="Center" Margin="20"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="XAML Code">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="XamlCodeTextBox" Background="#1E1E1E" Foreground="White" 
                                            FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True"
                                            Text="Generated XAML code will appear here"/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="C# Code">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="CSharpCodeTextBox" Background="#1E1E1E" Foreground="White" 
                                            FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True"
                                            Text="// Generated C# code will appear here"/>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Action Buttons -->
                        <Border Grid.Row="2" Background="#2D2D30" Height="60">
                            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                <Button x:Name="ExportXamlButton" Content="📤 Export XAML" Style="{StaticResource ActionButtonStyle}" 
                                       Click="ExportXamlButton_Click" Margin="5,0"/>
                                <Button x:Name="ExportCSharpButton" Content="📤 Export C#" Style="{StaticResource ActionButtonStyle}" 
                                       Click="ExportCSharpButton_Click" Margin="5,0"/>
                                <Button x:Name="CreateProjectButton" Content="🚀 Create Project" Style="{StaticResource ActionButtonStyle}" 
                                       Click="CreateProjectButton_Click" Margin="5,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- Styles -->
    <Window.Resources>
        <Style x:Key="ComponentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
