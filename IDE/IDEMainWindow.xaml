<Window x:Class="KimiAppNative.IDE.IDEMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OhGees IDE - Professional Development Environment" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="12,12,0,0" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="OhGees IDE" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" - Professional Development Environment" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="MinimizeButton" Content="─" Width="35" Height="30" 
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Click="MinimizeButton_Click" Margin="5,0"/>
                    <Button x:Name="MaximizeButton" Content="□" Width="35" Height="30" 
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Click="MaximizeButton_Click" Margin="5,0"/>
                    <Button x:Name="CloseButton" Content="✕" Width="35" Height="30" 
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Click="CloseButton_Click" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main IDE Content -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="0,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Menu Bar -->
                <Menu Grid.Row="0" Grid.ColumnSpan="3" Background="#2D2D30" Foreground="White" Height="30">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Project" Click="NewProject_Click"/>
                        <MenuItem Header="_Open Project" Click="OpenProject_Click"/>
                        <MenuItem Header="_Save" Click="Save_Click"/>
                        <MenuItem Header="_Save All" Click="SaveAll_Click"/>
                        <Separator/>
                        <MenuItem Header="_Recent Projects">
                            <MenuItem Header="Project 1" Click="OpenRecentProject_Click"/>
                            <MenuItem Header="Project 2" Click="OpenRecentProject_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Click="Undo_Click"/>
                        <MenuItem Header="_Redo" Click="Redo_Click"/>
                        <Separator/>
                        <MenuItem Header="Cu_t" Click="Cut_Click"/>
                        <MenuItem Header="_Copy" Click="Copy_Click"/>
                        <MenuItem Header="_Paste" Click="Paste_Click"/>
                        <Separator/>
                        <MenuItem Header="Find and Replace" Click="FindReplace_Click"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Solution Explorer" Click="ToggleSolutionExplorer_Click"/>
                        <MenuItem Header="_Properties" Click="ToggleProperties_Click"/>
                        <MenuItem Header="_Output" Click="ToggleOutput_Click"/>
                        <MenuItem Header="_Error List" Click="ToggleErrorList_Click"/>
                        <MenuItem Header="_Terminal" Click="ToggleTerminal_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Project">
                        <MenuItem Header="_Build" Click="Build_Click"/>
                        <MenuItem Header="_Rebuild" Click="Rebuild_Click"/>
                        <MenuItem Header="_Clean" Click="Clean_Click"/>
                        <MenuItem Header="Run" Click="Run_Click"/>
                        <MenuItem Header="Debug" Click="Debug_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Debug">
                        <MenuItem Header="Start Debugging" Click="StartDebugging_Click"/>
                        <MenuItem Header="Start Without Debugging" Click="StartWithoutDebugging_Click"/>
                        <MenuItem Header="Stop Debugging" Click="StopDebugging_Click"/>
                        <MenuItem Header="Restart" Click="Restart_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Options" Click="Options_Click"/>
                        <MenuItem Header="_Extensions" Click="Extensions_Click"/>
                        <MenuItem Header="AI Assistant" Click="AIAssistant_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                        <MenuItem Header="_About" Click="About_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Toolbar -->
                <ToolBar Grid.Row="1" Grid.Column="0" Background="#2D2D30" Height="40" VerticalAlignment="Top">
                    <Button x:Name="NewFileButton" Content="📄" ToolTip="New File" Click="NewFile_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="OpenFileButton" Content="📂" ToolTip="Open File" Click="OpenFile_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="SaveFileButton" Content="💾" ToolTip="Save File" Click="SaveFile_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Separator/>
                    <Button x:Name="UndoButton" Content="↶" ToolTip="Undo" Click="Undo_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="RedoButton" Content="↷" ToolTip="Redo" Click="Redo_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Separator/>
                    <Button x:Name="BuildButton" Content="🔨" ToolTip="Build" Click="Build_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="RunButton" Content="▶️" ToolTip="Run" Click="Run_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="DebugButton" Content="🐛" ToolTip="Debug" Click="Debug_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                </ToolBar>

                <!-- Left Panel - Solution Explorer -->
                <Border Grid.Row="1" Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,1,0" Margin="0,40,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Solution Explorer Header -->
                        <Border Grid.Row="0" Background="#2D2D30" Height="30">
                            <TextBlock Text="📁 Solution Explorer" Foreground="White" FontWeight="Bold" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>

                        <!-- Solution Tree -->
                        <TreeView Grid.Row="1" x:Name="SolutionExplorer" Background="#252526" Foreground="White" 
                                 BorderThickness="0" Margin="5">
                            <TreeViewItem Header="📁 Solution 'MyProject' (1 project)" IsExpanded="True">
                                <TreeViewItem Header="📁 MyProject" IsExpanded="True">
                                    <TreeViewItem Header="📁 Properties"/>
                                    <TreeViewItem Header="📁 References"/>
                                    <TreeViewItem Header="📄 Program.cs"/>
                                    <TreeViewItem Header="📄 App.xaml"/>
                                    <TreeViewItem Header="📄 MainWindow.xaml"/>
                                    <TreeViewItem Header="📄 MainWindow.xaml.cs"/>
                                </TreeViewItem>
                            </TreeViewItem>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Center Panel - Code Editor Area -->
                <Border Grid.Row="1" Grid.Column="1" Background="#1E1E1E">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Control for Open Files -->
                        <TabControl Grid.Row="1" x:Name="EditorTabs" Background="#1E1E1E" 
                                   BorderThickness="0" Margin="0,40,0,0">
                            <TabItem Header="Program.cs" x:Name="DefaultTab">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Code Editor -->
                                    <TextBox Grid.Row="0" x:Name="CodeEditor" 
                                            Background="#1E1E1E" Foreground="White" 
                                            FontFamily="Consolas" FontSize="14"
                                            TextWrapping="NoWrap" AcceptsReturn="True"
                                            AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto"
                                            Text="using System;&#x0a;&#x0a;namespace MyProject&#x0a;{&#x0a;    class Program&#x0a;    {&#x0a;        static void Main(string[] args)&#x0a;        {&#x0a;            Console.WriteLine(&quot;Hello, OhGees IDE!&quot;);&#x0a;        }&#x0a;    }&#x0a;}"
                                            BorderThickness="0"/>
                                    
                                    <!-- Status Bar for Editor -->
                                    <Border Grid.Row="1" Background="#2D2D30" Height="25">
                                        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="EditorStatus" Text="Line 1, Column 1" Foreground="White" FontSize="11"/>
                                            <TextBlock Text=" | " Foreground="#666666" Margin="10,0"/>
                                            <TextBlock x:Name="FileEncoding" Text="UTF-8" Foreground="#CCCCCC" FontSize="11"/>
                                            <TextBlock Text=" | " Foreground="#666666" Margin="10,0"/>
                                            <TextBlock x:Name="FileType" Text="C#" Foreground="#CCCCCC" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- Right Panel - Properties & Output -->
                <Border Grid.Row="1" Grid.Column="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Properties Header -->
                        <Border Grid.Row="0" Background="#2D2D30" Height="30">
                            <TextBlock Text="⚙️ Properties" Foreground="White" FontWeight="Bold" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                        </Border>

                        <!-- Properties Panel -->
                        <TabControl Grid.Row="1" Background="#252526" Foreground="White" BorderThickness="0">
                            <TabItem Header="Properties">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10" x:Name="PropertiesPanel">
                                        <TextBlock Text="Select an item to view properties" 
                                                  Foreground="#CCCCCC" FontStyle="Italic" 
                                                  HorizontalAlignment="Center" Margin="20"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Output">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="OutputTextBox" Background="#1E1E1E" Foreground="White" 
                                            FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True"
                                            Text="Build output will appear here...&#x0a;Ready to build project."/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Error List">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="ErrorList" Background="#1E1E1E" Foreground="White" 
                                            BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                        <ListBoxItem Foreground="Green">✓ Build completed successfully</ListBoxItem>
                                    </ListBox>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Terminal">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TerminalOutput" Background="#0C0C0C" Foreground="#00FF00" 
                                                FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                Text="OhGees IDE Terminal&#x0a;Type commands below...&#x0a;&#x0a;PS C:\Users\User\MyProject&gt; "/>
                                    </ScrollViewer>
                                    
                                    <TextBox Grid.Row="1" x:Name="TerminalInput" Background="#0C0C0C" Foreground="#00FF00" 
                                            FontFamily="Consolas" FontSize="12" BorderThickness="0,1,0,0"
                                            BorderBrush="#333333" KeyDown="TerminalInput_KeyDown"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Height="25">
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="11"/>
                <TextBlock Text=" | " Foreground="White" Margin="10,0"/>
                <TextBlock x:Name="ProjectStatus" Text="No project loaded" Foreground="White" FontSize="11"/>
                <TextBlock Text=" | " Foreground="White" Margin="10,0"/>
                <TextBlock x:Name="BuildStatus" Text="Build: Ready" Foreground="White" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Styles -->
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
