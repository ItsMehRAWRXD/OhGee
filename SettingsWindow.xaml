<Window x:Class="KimiAppNative.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KimiAppNative"
        mc:Ignorable="d"
        Title="OhGee Settings" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResize"
        MinHeight="500"
        MinWidth="700">
    
    <Window.Resources>
        <!-- Tab Header Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Margin="2"
                                Padding="15,10">
                            <ContentPresenter ContentSource="Header" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="#4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29B6F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0288D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#2D2D30" 
                Padding="20,15">
            <TextBlock Text="Settings" 
                       FontSize="24" 
                       FontWeight="Light" 
                       Foreground="#4FC3F7"/>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" 
                    Background="#1E1E1E" 
                    BorderThickness="0"
                    TabStripPlacement="Left">
            
            <!-- General Settings -->
            <TabItem Header="⚙️ General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="General Settings" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   Margin="0,0,0,15"/>

                        <!-- Startup Options -->
                        <GroupBox Header="Startup" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="StartWithWindows" 
                                          Content="Start with Windows"/>
                                <CheckBox x:Name="StartMinimized" 
                                          Content="Start minimized to system tray"/>
                                <CheckBox x:Name="CheckForUpdates" 
                                          Content="Check for updates on startup"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- UI Options -->
                        <GroupBox Header="User Interface" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Content="Theme:" Grid.Row="0" Grid.Column="0"/>
                                <ComboBox x:Name="ThemeSelector" Grid.Row="0" Grid.Column="1">
                                    <ComboBoxItem>Dark</ComboBoxItem>
                                    <ComboBoxItem>Light</ComboBoxItem>
                                    <ComboBoxItem>Auto (System)</ComboBoxItem>
                                </ComboBox>

                                <Label Content="Language:" Grid.Row="1" Grid.Column="0"/>
                                <ComboBox x:Name="LanguageSelector" Grid.Row="1" Grid.Column="1">
                                    <ComboBoxItem>English</ComboBoxItem>
                                    <ComboBoxItem>中文</ComboBoxItem>
                                    <ComboBoxItem>Español</ComboBoxItem>
                                    <ComboBoxItem>Français</ComboBoxItem>
                                    <ComboBoxItem>Deutsch</ComboBoxItem>
                                    <ComboBoxItem>日本語</ComboBoxItem>
                                </ComboBox>

                                <Label Content="Window Opacity:" Grid.Row="2" Grid.Column="0"/>
                                <Slider x:Name="OpacitySlider" 
                                        Grid.Row="2" Grid.Column="1" 
                                        Minimum="0.5" Maximum="1" 
                                        Value="1" 
                                        TickFrequency="0.1" 
                                        IsSnapToTickEnabled="True"
                                        Margin="5"/>

                                <CheckBox x:Name="AlwaysOnTop" 
                                          Content="Always on top" 
                                          Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Performance -->
                        <GroupBox Header="Performance" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="HardwareAcceleration" 
                                          Content="Enable hardware acceleration"/>
                                <CheckBox x:Name="ReduceAnimations" 
                                          Content="Reduce animations"/>
                                <CheckBox x:Name="LowPowerMode" 
                                          Content="Low power mode"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI Providers -->
            <TabItem Header="🤖 AI Providers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="AI Provider Configuration" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   Margin="0,0,0,15"/>

                        <!-- OpenAI -->
                        <Expander Header="OpenAI (ChatGPT)" 
                                  Foreground="#E0E0E0" 
                                  Margin="0,5">
                            <StackPanel Margin="10">
                                <Label Content="API Key:"/>
                                <PasswordBox x:Name="OpenAIApiKey" 
                                             Background="#2D2D30" 
                                             Foreground="#E0E0E0" 
                                             BorderBrush="#3E3E42" 
                                             Padding="8,5" 
                                             Margin="5"/>
                                <Label Content="Model:"/>
                                <ComboBox x:Name="OpenAIModel">
                                    <ComboBoxItem>gpt-3.5-turbo</ComboBoxItem>
                                    <ComboBoxItem>gpt-4</ComboBoxItem>
                                    <ComboBoxItem>gpt-4-turbo</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="OpenAIEnabled" 
                                          Content="Enable OpenAI provider"/>
                                <Button Content="Test Connection" 
                                        Style="{StaticResource SettingsButton}" 
                                        Click="TestOpenAIConnection_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Moonshot -->
                        <Expander Header="Moonshot (Kimi)" 
                                  Foreground="#E0E0E0" 
                                  Margin="0,5">
                            <StackPanel Margin="10">
                                <Label Content="API Key:"/>
                                <PasswordBox x:Name="MoonshotApiKey" 
                                             Background="#2D2D30" 
                                             Foreground="#E0E0E0" 
                                             BorderBrush="#3E3E42" 
                                             Padding="8,5" 
                                             Margin="5"/>
                                <Label Content="Model:"/>
                                <ComboBox x:Name="MoonshotModel">
                                    <ComboBoxItem>moonshot-v1-8k</ComboBoxItem>
                                    <ComboBoxItem>moonshot-v1-32k</ComboBoxItem>
                                    <ComboBoxItem>moonshot-v1-128k</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="MoonshotEnabled" 
                                          Content="Enable Moonshot provider"/>
                                <Button Content="Test Connection" 
                                        Style="{StaticResource SettingsButton}" 
                                        Click="TestMoonshotConnection_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- DeepSeek -->
                        <Expander Header="DeepSeek" 
                                  Foreground="#E0E0E0" 
                                  Margin="0,5">
                            <StackPanel Margin="10">
                                <Label Content="API Key:"/>
                                <PasswordBox x:Name="DeepSeekApiKey" 
                                             Background="#2D2D30" 
                                             Foreground="#E0E0E0" 
                                             BorderBrush="#3E3E42" 
                                             Padding="8,5" 
                                             Margin="5"/>
                                <Label Content="Model:"/>
                                <ComboBox x:Name="DeepSeekModel">
                                    <ComboBoxItem>deepseek-chat</ComboBoxItem>
                                    <ComboBoxItem>deepseek-coder</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="DeepSeekEnabled" 
                                          Content="Enable DeepSeek provider"/>
                                <Button Content="Test Connection" 
                                        Style="{StaticResource SettingsButton}" 
                                        Click="TestDeepSeekConnection_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Custom Provider -->
                        <Expander Header="Custom Provider" 
                                  Foreground="#E0E0E0" 
                                  Margin="0,5">
                            <StackPanel Margin="10">
                                <Label Content="Endpoint URL:"/>
                                <TextBox x:Name="CustomEndpoint"/>
                                <Label Content="API Key:"/>
                                <PasswordBox x:Name="CustomApiKey" 
                                             Background="#2D2D30" 
                                             Foreground="#E0E0E0" 
                                             BorderBrush="#3E3E42" 
                                             Padding="8,5" 
                                             Margin="5"/>
                                <Label Content="Model:"/>
                                <TextBox x:Name="CustomModel"/>
                                <CheckBox x:Name="CustomEnabled" 
                                          Content="Enable custom provider"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys -->
            <TabItem Header="⌨️ Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Hotkey Configuration" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   Margin="0,0,0,15"/>

                        <DataGrid x:Name="HotkeysGrid" 
                                  AutoGenerateColumns="False" 
                                  Background="#2D2D30" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Action" 
                                                    Binding="{Binding Action}" 
                                                    Width="200" 
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Current Hotkey" 
                                                    Binding="{Binding Hotkey}" 
                                                    Width="150"/>
                                <DataGridCheckBoxColumn Header="Enabled" 
                                                         Binding="{Binding IsEnabled}" 
                                                         Width="70"/>
                                <DataGridTemplateColumn Header="Edit" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Change" 
                                                    Click="ChangeHotkey_Click" 
                                                    Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Reset to Defaults" 
                                Style="{StaticResource SettingsButton}" 
                                HorizontalAlignment="Left" 
                                Margin="0,10" 
                                Click="ResetHotkeys_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Voice Settings -->
            <TabItem Header="🎤 Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Voice Settings" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   Margin="0,0,0,15"/>

                        <!-- Speech Recognition -->
                        <GroupBox Header="Speech Recognition" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnableVoiceInput" 
                                          Content="Enable voice input"/>
                                <CheckBox x:Name="EnableWakeWord" 
                                          Content="Enable wake word detection"/>
                                <Label Content="Wake word:"/>
                                <TextBox x:Name="WakeWord" Text="Hey OhGee"/>
                                <Label Content="Recognition Language:"/>
                                <ComboBox x:Name="RecognitionLanguage">
                                    <ComboBoxItem>English (US)</ComboBoxItem>
                                    <ComboBoxItem>English (UK)</ComboBoxItem>
                                    <ComboBoxItem>Chinese (Simplified)</ComboBoxItem>
                                    <ComboBoxItem>Spanish</ComboBoxItem>
                                    <ComboBoxItem>French</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="NoiseSuppression" 
                                          Content="Enable noise suppression"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Text to Speech -->
                        <GroupBox Header="Text to Speech" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnableVoiceOutput" 
                                          Content="Enable voice output"/>
                                <Label Content="Voice:"/>
                                <ComboBox x:Name="TTSVoice">
                                    <!-- Populated dynamically -->
                                </ComboBox>
                                <Label Content="Speech Rate:"/>
                                <Slider x:Name="SpeechRate" 
                                        Minimum="-10" Maximum="10" 
                                        Value="0" 
                                        TickFrequency="1" 
                                        IsSnapToTickEnabled="True"/>
                                <Label Content="Volume:"/>
                                <Slider x:Name="SpeechVolume" 
                                        Minimum="0" Maximum="100" 
                                        Value="100" 
                                        TickFrequency="10" 
                                        IsSnapToTickEnabled="True"/>
                                <Button Content="Test Voice" 
                                        Style="{StaticResource SettingsButton}" 
                                        Click="TestVoice_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Plugins -->
            <TabItem Header="🧩 Plugins">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Plugin Management" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#4FC3F7" 
                               Grid.Row="0" 
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="PluginsGrid" 
                              Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              Background="#2D2D30" 
                              Foreground="#E0E0E0" 
                              BorderBrush="#3E3E42" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plugin Name" 
                                                Binding="{Binding Name}" 
                                                Width="200"/>
                            <DataGridTextColumn Header="Version" 
                                                Binding="{Binding Version}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="Author" 
                                                Binding="{Binding Author}" 
                                                Width="150"/>
                            <DataGridCheckBoxColumn Header="Enabled" 
                                                     Binding="{Binding IsEnabled}" 
                                                     Width="70"/>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Configure" 
                                                    Margin="2" 
                                                    Click="ConfigurePlugin_Click" 
                                                    Tag="{Binding}"/>
                                            <Button Content="Uninstall" 
                                                    Margin="2" 
                                                    Click="UninstallPlugin_Click" 
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                Margin="0,10">
                        <Button Content="Install Plugin..." 
                                Style="{StaticResource SettingsButton}" 
                                Click="InstallPlugin_Click"/>
                        <Button Content="Browse Plugin Store" 
                                Style="{StaticResource SettingsButton}" 
                                Click="BrowsePluginStore_Click"/>
                        <Button Content="Refresh" 
                                Style="{StaticResource SettingsButton}" 
                                Click="RefreshPlugins_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Privacy -->
            <TabItem Header="🔒 Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Privacy Settings" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   Margin="0,0,0,15"/>

                        <!-- Data Collection -->
                        <GroupBox Header="Data Collection" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SendAnalytics" 
                                          Content="Send anonymous usage statistics"/>
                                <CheckBox x:Name="SendCrashReports" 
                                          Content="Send crash reports"/>
                                <CheckBox x:Name="ImproveRecognition" 
                                          Content="Help improve voice recognition"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Data Storage -->
                        <GroupBox Header="Data Storage" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SaveConversations" 
                                          Content="Save conversation history"/>
                                <Label Content="History retention:"/>
                                <ComboBox x:Name="HistoryRetention">
                                    <ComboBoxItem>Forever</ComboBoxItem>
                                    <ComboBoxItem>30 days</ComboBoxItem>
                                    <ComboBoxItem>7 days</ComboBoxItem>
                                    <ComboBoxItem>1 day</ComboBoxItem>
                                    <ComboBoxItem>Never</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Clear All History" 
                                        Style="{StaticResource SettingsButton}" 
                                        Background="#F44336" 
                                        Click="ClearHistory_Click"/>
                                <Button Content="Export Data" 
                                        Style="{StaticResource SettingsButton}" 
                                        Click="ExportData_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Security -->
                        <GroupBox Header="Security" 
                                  Foreground="#E0E0E0" 
                                  BorderBrush="#3E3E42" 
                                  Margin="0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EncryptLocalData" 
                                          Content="Encrypt local data"/>
                                <CheckBox x:Name="RequireAuthentication" 
                                          Content="Require authentication on startup"/>
                                <CheckBox x:Name="SecureClipboard" 
                                          Content="Clear clipboard after paste"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem Header="ℹ️ About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="About OhGee" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#4FC3F7" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,20"/>
                        
                        <Image Source="pack://application:,,,/Resources/logo.png" 
                               Height="100" 
                               Width="100" 
                               HorizontalAlignment="Center" 
                               Margin="0,10"/>

                        <TextBlock Text="Version 1.0.0" 
                                   FontSize="16" 
                                   Foreground="#E0E0E0" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5"/>

                        <TextBlock Text="AI Assistant Hub for Windows" 
                                   FontSize="14" 
                                   Foreground="#999" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5"/>

                        <TextBlock Text="Copyright © 2025 OhGee" 
                                   FontSize="12" 
                                   Foreground="#999" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,20"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,20">
                            <Button Content="Check for Updates" 
                                    Style="{StaticResource SettingsButton}" 
                                    Click="CheckUpdates_Click"/>
                            <Button Content="View License" 
                                    Style="{StaticResource SettingsButton}" 
                                    Click="ViewLicense_Click"/>
                            <Button Content="Report Issue" 
                                    Style="{StaticResource SettingsButton}" 
                                    Click="ReportIssue_Click"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#E0E0E0" 
                                   Margin="0,20" 
                                   TextAlignment="Center">
                            OhGee is an open-source AI assistant hub that provides seamless access to multiple AI models through a unified interface.
                        </TextBlock>

                        <TextBlock Text="Credits" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4FC3F7" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,20,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#999" 
                                   TextAlignment="Center">
                            Built with love using WPF, .NET 8, and various open-source libraries.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer with action buttons -->
        <Border Grid.Row="2" 
                Background="#2D2D30" 
                Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left">
                    <Button Content="Import Settings" 
                            Style="{StaticResource SettingsButton}" 
                            Click="ImportSettings_Click"/>
                    <Button Content="Export Settings" 
                            Style="{StaticResource SettingsButton}" 
                            Click="ExportSettings_Click"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Apply" 
                            Style="{StaticResource SettingsButton}" 
                            Click="ApplySettings_Click"/>
                    <Button Content="Save" 
                            Style="{StaticResource SettingsButton}" 
                            Click="SaveSettings_Click"/>
                    <Button Content="Cancel" 
                            Style="{StaticResource SettingsButton}" 
                            Background="#757575" 
                            Click="CancelSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>